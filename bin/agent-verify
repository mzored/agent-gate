#!/usr/bin/env python3
"""The `agent-verify` command-line contract, served by agent-gate.

    agent-verify status [--json]
    agent-verify inherited [--memory GIB] [--cpus N]   exit 0 inside a live run covering N or while the gate is off, 1 outside,
                                                       78 when the run's budget is below N or the gate is unusable
    agent-verify [run] --cpus N [--memory GIB] [--timeout S] [--label L] [--wait S | --no-wait] -- CMD...

The translator forwards options rather than deciding for agent-gate: `status` takes
agent-gate's own arguments, and `--wait` with `--no-wait` is agent-gate's usage error (exit 2).

Memory is no longer reserved in GiB: admission follows the kernel's memory
signal, so --memory is accepted and ignored. Named resources are project-owned
locks now; a request for one is refused rather than silently unprotected.
"""

import argparse
from pathlib import Path
import sys

if sys.platform != "darwin":
    raise SystemExit("agent-verify requires macOS")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
# This compatibility command calls agent_gate's existing CLI functions.
import agent_gate  # noqa: E402


def ignored_memory(text):
    """--memory is ignored, but a malformed value is still a malformed request."""
    if text is not None:
        agent_gate.finite(text, "--memory")


def main(argv):
    try:
        return dispatch(argv)
    except agent_gate.ConfigError as error:
        agent_gate.say(f"unusable: {error}")
        return agent_gate.CONFIG_EXIT


def dispatch(argv):
    if argv[:1] == ["status"]:
        return agent_gate.status(argv[1:])
    if argv[:1] == ["inherited"]:
        parser = argparse.ArgumentParser(prog="agent-verify inherited")
        parser.add_argument("--memory", default=None)
        parser.add_argument("--cpus", default=None)
        args = parser.parse_args(argv[1:])
        ignored_memory(args.memory)
        return agent_gate.inside([] if args.cpus is None else ["-c", args.cpus])
    if argv[:1] == ["run"]:
        argv = argv[1:]
    parser = argparse.ArgumentParser(prog="agent-verify")
    parser.add_argument("--memory", default=None)
    parser.add_argument("--cpus", default=None)
    parser.add_argument("--resource", action="append", default=[])
    parser.add_argument("--label", default="")
    parser.add_argument("--wait", default=None)
    parser.add_argument("--no-wait", action="store_true")
    parser.add_argument("--timeout", default=None)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    ignored_memory(args.memory)
    if args.resource:
        agent_gate.say("named resources are project-owned locks now; nothing ran")
        return agent_gate.CONFIG_EXIT
    gate = []
    if args.cpus is not None:
        gate += ["-c", args.cpus]
    if args.label:
        gate += ["-l", args.label]
    # Both flags are forwarded as given: agent-gate itself refuses the combination (usage error, exit 2).
    if args.wait is not None:
        gate += ["--wait", args.wait]
    if args.no_wait:
        gate.append("--no-wait")
    if args.timeout is not None:
        gate += ["--timeout", args.timeout]
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    return agent_gate.run([*gate, "--", *command])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
