#!/usr/bin/env python3
"""Install and check the host wiring agent-gate depends on; see lib/gate_host.py."""

from pathlib import Path
import sys

if sys.platform != "darwin":
    raise SystemExit("gate-host requires macOS")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import gate_host  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(gate_host.main())
